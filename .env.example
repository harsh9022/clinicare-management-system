# Copy this file to .env and fill in your own values.
# .env is git-ignored — .env.example is the one safe to commit.

# MongoDB Atlas connection string (from Atlas → Connect → Drivers).
# Replace <db_username> and <db_password> with your database user's
# credentials, NOT your Atlas account login.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Database name to use inside the cluster (created automatically if missing).
MONGODB_DB=clinicare

# Local port. Render/Vercel/Cloud Run set this automatically in production.
PORT=8080
